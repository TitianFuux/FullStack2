# Copia este archivo como .env.development (npm run dev) o .env.production (npm run build).
# Todo lo que empieza con VITE_ queda a la vista en el navegador: aquí va la URL de la API, nunca una clave secreta.
# Si cambias un .env, reinicia npm run dev o vuelve a compilar.
VITE_API_URL=http://localhost:8080/api/v1
